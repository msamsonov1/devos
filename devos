  </div>

  <script>
    // State storage for prospects
    let leads = [
      { id: '1', name: 'Dan Kowalski (CTO)', company: 'FleetMetrics', trigger: 'Hiring Sr. Node Lead', stage: 'outreach', day: 'Day 1' },
      { id: '2', name: 'Elena Ramos (VP Product)', company: 'CareSync EHR', trigger: 'Legacy iOS Refactor', stage: 'followup', day: 'Day 5' },
      { id: '3', name: 'Marcus Chen (Founder)', company: 'PayFlow API', trigger: 'Series A Milestone', stage: 'meeting', day: 'Discovery Call Fri' },
      { id: '4', name: 'David Vance (COO)', company: 'Apex Freight', trigger: 'No budget response', stage: 'closed', day: 'Breakup Sent' }
