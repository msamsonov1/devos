        channel: 'Phone Call / Voicemail',
        icon: 'ph-phone-call',
        color: 'emerald',
        angle: '30-Second Pattern Interrupt',
        desc: 'Brief call referencing the email thread. Never sound like a script-reading telemarketer.',
        metric: 'Shows human presence'
