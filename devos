    // Objections playbook dataset
    const objectionPlaybooks = [
      {
        title: '"Send me your capabilities deck / presentation"',
        tag: 'Information Stall',
        color: 'indigo',
        context: 'Sending a generic 30-slide PDF guarantees it gets buried. Qualify their exact need instead.',
        response: `Happy to share our work! To make sure I only send relevant case studies rather than a generic 20-page deck: are you focused more on mobile frontends (React Native/Flutter), or backend infrastructure and third-party APIs right now?`
      },
      {
        title: '"We handle all software engineering in-house"',
        tag: 'Internal Preference',
        color: 'emerald',
        context: 'Validate their setup. In-house is always best, but roadmap overflows happen constantly.',
        response: `Makes total sense—an internal team is always the best core. Out of curiosity, do you ever bring on specialized outside bandwidth for 4-to-6-week sprint overflows, or do you strictly hold off until your full-time hires ramp up?`
      },
      {
        title: '"We don\'t have any budget for this right now"',
        tag: 'Budget Freeze',
        color: 'amber',
        context: 'Do not push a contract. Offer an asynchronous freebie and lock in permission to follow up next quarter.',
        response: `Completely understand—budgets are tight this quarter. If you'd like, I can still run a quick complimentary review on your current {Product Area} architecture so you have it ready for Q3 planning. Would that be helpful?`
      },
      {
        title: '"We already have an offshore/outsourcing partner"',
        tag: 'Vendor Incumbent',
        color: 'rose',
        context: 'Acknowledge their vendor. Target offshore friction points (time zone lag, code documentation quality).',
        response: `Great to hear you have that covered. Most teams we speak with use offshore for maintenance, but lean on us when they need senior US-timezone engineers to tackle complex architectural refactors with zero communication delay. Worth keeping in touch for future overflow?`
      }
    ];

    // Templates dictionary
    const templates = {
      email1: {
        title: "Email 1 - Day 1: The Specific Observation",
        subtitle: "Trigger: Active developer job posting or public roadmap pressure",
        channelTip: "Tip: Never send this from your primary domain. Always warm secondary sending inboxes via Instantly/Smartlead.",
        subject: "{Company} roadmap / {Trigger}",
        body: `Hi {First_Name},

Saw that you're hiring for a {Trigger} to help build out {Product}. Given the typical 3-month cycle to recruit and onboard specialized engineers, sprint roadmaps often get backed up.

We run an agile development shop helping engineering leaders deploy production-ready features while they finish their permanent hiring. Recently, we helped {Proof_Client} and {Proof_Result}.

Are you open to seeing how we could handle a sprint or two of that backlog while you finalize the full-time team?

Best,
{Sender}`
      },
      linkedin: {
        title: "LinkedIn Connection Note (Day 2)",
        subtitle: "Character count: ~200 chars. Soft and non-salesy.",
        channelTip: "Tip: If sending via mobile app, blank requests often outperform long pitches.",
        subject: "LinkedIn Connection Note",
        body: `Hi {First_Name} – noticed {Company}'s recent work on {Product} and saw you're expanding engineering. Thought I'd connect and follow your team's launch progress.`
      },
      email2: {
        title: "Email 2 - Day 5: The Peer Proof Point",
        subtitle: "Channel: Threaded reply to original message",
        channelTip: "Tip: Threading is crucial. It keeps your original observation visible at the bottom.",
        subject: "Re: {Company} roadmap / {Trigger}",
        body: `Hi {First_Name},

To give you quick context on my note earlier: when {Proof_Client} was scaling their platform, their internal team was bottlenecked on rapid deployment.

We embedded 2 senior engineers into their sprint within 5 days, cleared their core ticket backlog, and handed over cleanly documented code before their full-time hire even started.

Worth a brief 10-minute sync this Thursday to see if our tech stack aligns with what you need?

Best,
{Sender}`
      },
      call: {
        title: "Phone Script - Day 11: 30-Second Pattern Interrupt",
        subtitle: "Target: CTO / VP Engineering voicemail or direct pickup",
        channelTip: "Tip: Speak calmly and deliberately. Acknowledge immediately that you are interrupting.",
        subject: "Phone Outreach Script",
        body: `[If direct answer]:
"Hey {First_Name}, this is {Sender}. I know you weren't expecting my call, so I'll be brief—do you have 30 seconds?

I sent a note last week regarding your search for a {Trigger} at {Company}. We help engineering teams knock out 1 or 2 backlog sprints so product launches don't stall while recruiting. 

Are you open to a brief chat later this week, or is your internal bandwidth totally covered?"

[If Voicemail]:
"Hey {First_Name}, {Sender} here. Saw your opening for a {Trigger} at {Company}. Shot you an email about how we help bridge the gap on sprint delays for teams like {Proof_Client}. Check your inbox under '{Company} roadmap' when you get a chance. Talk soon."`
      },
      email3: {
        title: "Email 3 - Day 15: The Low-Friction Value Asset",
        subtitle: "Channel: Threaded reply to original message",
        channelTip: "Tip: Low commitment. Offering a specific free audit reduces sales resistance.",
        subject: "Re: {Company} roadmap / {Trigger}",
        body: `Hi {First_Name},

Appreciate that vetting an external dev partner takes time and trust.

If you have an active backlog ticket or a feature spec for {Product} that's stalled, send over the brief. We’ll map out a recommended technical architecture and scope breakdown for free—even if you end up having your internal team build it.

Would that be useful for your team this sprint?

Best,
{Sender}`
      },
      email4: {
        title: "Email 4 - Day 21: The Clean Breakup",
        subtitle: "Channel: Threaded reply to original message",
        channelTip: "Tip: This generates 20-30% of your total responses by removing sales pressure.",
        subject: "Re: {Company} roadmap / {Trigger}",
        body: `Hi {First_Name},

Usually when I don't hear back, it means one of two things: either {Company}'s dev roadmap is fully staffed and on track, or this simply isn't a priority right now.

Either way, I don't want to clutter your inbox. I'll circle back in a few months to see how your {Product} launch went.

If your bandwidth changes before then, feel free to reach out anytime.

Best,
{Sender}`
      }
    };

    let currentTemplateKey = 'email1';

    document.addEventListener('DOMContentLoaded', () => {
      renderCadenceCards();
      renderObjections();
      renderTemplates();
      renderKanban();
      setupTabs();
      setupTemplatePills();
      setupInputListeners();
      setupModal();
    });

    // Tab Switcher
    function setupTabs() {
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabContents = document.querySelectorAll('.tab-content');

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-tab');

          tabBtns.forEach(b => {
            b.classList.remove('active', 'text-white', 'bg-indigo-600', 'shadow-sm', 'shadow-indigo-600/30');
            b.classList.add('text-slate-400', 'hover:text-slate-200', 'hover:bg-slate-900');
          });

          btn.classList.add('active', 'text-white', 'bg-indigo-600', 'shadow-sm', 'shadow-indigo-600/30');
          btn.classList.remove('text-slate-400', 'hover:text-slate-200', 'hover:bg-slate-900');

          tabContents.forEach(content => {
            if (content.id === `${target}Tab`) {
              content.classList.remove('hidden');
              content.classList.add('block');
            } else {
              content.classList.remove('block');
              content.classList.add('hidden');
            }
          });
        });
      });
    }

    // Render 21-Day Cadence
    function renderCadenceCards() {
      const container = document.getElementById('cadenceGrid');
      container.innerHTML = cadenceSteps.map((step, idx) => `
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col justify-between hover:border-slate-700 transition">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-indigo-400 px-2 py-0.5 rounded bg-indigo-950/80 border border-indigo-800/60">${step.day}</span>
              <span class="text-[11px] text-slate-400 flex items-center gap-1">
                <i class="ph ${step.icon}"></i> ${step.channel}
              </span>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-slate-200">${step.angle}</h4>
              <p class="text-xs text-slate-400 mt-1 leading-relaxed">${step.desc}</p>
            </div>
          </div>
          <div class="pt-3 mt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px]">
            <span class="text-slate-400">${step.metric}</span>
            <button onclick="jumpToTemplate('${idx === 0 ? 'email1' : idx === 1 ? 'linkedin' : idx === 2 ? 'email2' : idx === 4 ? 'call' : idx === 5 ? 'email3' : 'email4'}')" class="text-indigo-400 hover:text-indigo-300 font-medium flex items-center gap-0.5">
              <span>View Copy</span>
              <i class="ph ph-caret-right"></i>
            </button>
          </div>
        </div>
      `).join('');
    }

    // Render Objections
    function renderObjections() {
      const container = document.getElementById('objectionCards');
      container.innerHTML = objectionPlaybooks.map((obj, i) => `
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-3.5 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded-full bg-${obj.color}-500/10 text-${obj.color}-400 border border-${obj.color}-500/20 font-semibold">${obj.tag}</span>
              <button onclick="copyObjectionText(${i})" class="text-xs text-slate-400 hover:text-indigo-300 transition flex items-center gap-1">
                <i class="ph ph-copy"></i> Copy Script
              </button>
            </div>
            <h4 class="text-sm font-bold text-slate-200">${obj.title}</h4>
            <p class="text-xs text-slate-400 leading-relaxed">${obj.context}</p>
          </div>
          <div class="bg-slate-950 p-3 rounded-xl border border-slate-800/80 text-xs font-sans text-slate-300 italic">
            "${obj.response}"
          </div>
        </div>
      `).join('');
    }

    // Render Template View
    function renderTemplates() {
      const t = templates[currentTemplateKey];
      const fn = document.getElementById('varFirstName').value || 'Alex';
      const co = document.getElementById('varCompany').value || 'Nexus Logistics';
      const tr = document.getElementById('varTrigger').value || 'Senior React Native Developer';
      const pr = document.getElementById('varProduct').value || 'driver mobile dispatch app';
      const cl = document.getElementById('varProofClient').value || 'FleetTrack Inc.';
      const res = document.getElementById('varProofResult').value || 'shaved 4 weeks off their launch cycle';
      const snd = document.getElementById('varSender').value || 'Marcus | ShiftBit Labs';

      // Replacements
      const replaceVars = (str) => {
        return str
          .replaceAll('{First_Name}', fn)
          .replaceAll('{Company}', co)
          .replaceAll('{Trigger}', tr)
          .replaceAll('{Product}', pr)
          .replaceAll('{Proof_Client}', cl)
          .replaceAll('{Proof_Result}', res)
          .replaceAll('{Sender}', snd);
      };

      document.getElementById('previewTitle').innerText = t.title;
      document.getElementById('previewSubtitle').innerText = t.subtitle;
      document.getElementById('channelTip').innerText = t.channelTip;
      document.getElementById('subjectText').innerText = replaceVars(t.subject);
      document.getElementById('bodyText').innerText = replaceVars(t.body);
    }

    function setupTemplatePills() {
      const pills = document.querySelectorAll('.template-pill');
      pills.forEach(pill => {
        pill.addEventListener('click', () => {
          pills.forEach(p => {
            p.classList.remove('bg-indigo-600', 'text-white');
            p.classList.add('bg-slate-900', 'text-slate-300');
          });
          pill.classList.remove('bg-slate-900', 'text-slate-300');
          pill.classList.add('bg-indigo-600', 'text-white');

          currentTemplateKey = pill.getAttribute('data-template');
          renderTemplates();
        });
      });
    }

    function setupInputListeners() {
      const inputs = [
        'varFirstName', 'varCompany', 'varTrigger', 'varProduct',
        'varProofClient', 'varProofResult', 'varSender'
      ];
      inputs.forEach(id => {
        document.getElementById(id).addEventListener('input', renderTemplates);
      });

      // Preset button
      document.getElementById('applyPresetsBtn').addEventListener('click', () => {
        document.getElementById('varFirstName').value = 'Jason';
        document.getElementById('varCompany').value = 'FinStack Cloud';
        document.getElementById('varTrigger').value = 'Lead DevOps Engineer';
        document.getElementById('varProduct').value = 'multi-region AWS migration';
        document.getElementById('varProofClient').value = 'LedgerCore';
        document.getElementById('varProofResult').value = 'reduced cloud infra overhead by 38%';
        document.getElementById('varSender').value = 'Sarah | CloudNative Labs';
        renderTemplates();
        showToast('Preset Loaded', 'SaaS founder scenario populated across templates.');
      });

      // Reset Defaults button
      document.getElementById('resetDemoBtn').addEventListener('click', () => {
        document.getElementById('varFirstName').value = 'Alex';
        document.getElementById('varCompany').value = 'Nexus Logistics';
        document.getElementById('varTrigger').value = 'Senior React Native Developer';
        document.getElementById('varProduct').value = 'driver mobile dispatch app';
        document.getElementById('varProofClient').value = 'FleetTrack Inc.';
        document.getElementById('varProofResult').value = 'shaved 4 weeks off their launch cycle';
        document.getElementById('varSender').value = 'Marcus | ShiftBit Labs';
        renderTemplates();
        showToast('Reset Complete', 'Default values restored.');
      });

      // Copy buttons
      document.getElementById('copySubjectBtn').addEventListener('click', () => {
        const text = document.getElementById('subjectText').innerText;
        copyToClipboard(text);
        showToast('Subject Copied', text);
      });

      document.getElementById('copyBodyBtn').addEventListener('click', () => {
        const text = document.getElementById('bodyText').innerText;
        copyToClipboard(text);
        showToast('Body Copied', 'Template ready for sending.');
      });
    }

    // Direct jump from Cadence card to Template
    window.jumpToTemplate = function(templateKey) {
      currentTemplateKey = templateKey;
      
      // Switch active tab to generator
      const generatorBtn = document.querySelector('[data-tab="generator"]');
      generatorBtn.click();

      // Switch active pill
      const pills = document.querySelectorAll('.template-pill');
      pills.forEach(p => {
        if (p.getAttribute('data-template') === templateKey) {
          p.classList.remove('bg-slate-900', 'text-slate-300');
          p.classList.add('bg-indigo-600', 'text-white');
        } else {
          p.classList.remove('bg-indigo-600', 'text-white');
          p.classList.add('bg-slate-900', 'text-slate-300');
        }
      });
      renderTemplates();
    };

    // Copy Objection Script
    window.copyObjectionText = function(index) {
      const script = objectionPlaybooks[index].response;
      copyToClipboard(script);
      showToast('Objection Script Copied', 'Ready to paste in your email or LinkedIn reply.');
    };

    // Render Kanban Leads
    function renderKanban() {
      const columns = {
        outreach: document.getElementById('col-outreach'),
        followup: document.getElementById('col-followup'),
        meeting: document.getElementById('col-meeting'),
        closed: document.getElementById('col-closed')
      };

      const counts = { outreach: 0, followup: 0, meeting: 0, closed: 0 };

      // Clear columns
      Object.values(columns).forEach(col => col.innerHTML = '');

      leads.forEach(lead => {
        counts[lead.stage]++;
        const card = document.createElement('div');
        card.className = "bg-slate-950 border border-slate-800 rounded-xl p-3 space-y-2 hover:border-slate-700 transition";
        card.innerHTML = `
          <div class="flex items-start justify-between">
            <div>
              <p class="font-semibold text-xs text-slate-200">${lead.name}</p>
              <p class="text-[11px] text-slate-400">${lead.company}</p>
            </div>
            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-900 text-indigo-400 border border-indigo-900/40">${lead.day}</span>
          </div>
          <p class="text-[11px] text-slate-400 bg-slate-900/60 p-1.5 rounded-lg border border-slate-900 font-mono flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span> ${lead.trigger}
          </p>
          <div class="flex items-center justify-between pt-1">
            <select onchange="updateLeadStage('${lead.id}', this.value)" class="bg-slate-900 text-[10px] text-slate-300 rounded border border-slate-800 px-1.5 py-0.5 focus:outline-none">
              <option value="outreach" ${lead.stage === 'outreach' ? 'selected' : ''}>Stage 1: Day 1-2</option>
              <option value="followup" ${lead.stage === 'followup' ? 'selected' : ''}>Stage 2: Followup</option>
              <option value="meeting" ${lead.stage === 'meeting' ? 'selected' : ''}>Stage 3: Meeting</option>
              <option value="closed" ${lead.stage === 'closed' ? 'selected' : ''}>Stage 4: Closed/Breakup</option>
            </select>
            <button onclick="deleteLead('${lead.id}')" class="text-slate-500 hover:text-rose-400 text-xs p-1">
              <i class="ph ph-trash"></i>
            </button>
          </div>
        `;
        columns[lead.stage].appendChild(card);
      });

      // Update counters
      document.getElementById('colCount-outreach').innerText = counts.outreach;
      document.getElementById('colCount-followup').innerText = counts.followup;
      document.getElementById('colCount-meeting').innerText = counts.meeting;
      document.getElementById('colCount-closed').innerText = counts.closed;
    }

    window.updateLeadStage = function(id, newStage) {
      const item = leads.find(l => l.id === id);
      if (item) {
        item.stage = newStage;
        if (newStage === 'meeting') item.day = 'Meeting Booked';
        if (newStage === 'closed') item.day = 'Cycle Complete';
        renderKanban();
        showToast('Lead Moved', `${item.company} updated.`);
      }
    };

    window.deleteLead = function(id) {
      leads = leads.filter(l => l.id !== id);
      renderKanban();
      showToast('Lead Removed', 'Lead deleted from board.');
    };

    // Modal Logic
    function setupModal() {
      const modal = document.getElementById('addModalOverlay');
      const openBtn = document.getElementById('addLeadModalBtn');
      const closeBtn = document.getElementById('closeModalBtn');
      const cancelBtn = document.getElementById('cancelModalBtn');
      const form = document.getElementById('newLeadForm');

      const closeModal = () => modal.classList.add('hidden');
      const openModal = () => modal.classList.remove('hidden');

      openBtn.addEventListener('click', openModal);
      closeBtn.addEventListener('click', closeModal);
      cancelBtn.addEventListener('click', closeModal);

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const newLead = {
          id: Date.now().toString(),
          name: document.getElementById('leadName').value,
          company: document.getElementById('leadCompany').value,
          trigger: document.getElementById('leadTrigger').value,
          stage: document.getElementById('leadStage').value,
          day: document.getElementById('leadStage').value === 'meeting' ? 'Call Set' : 'Day 1'
        };
        leads.unshift(newLead);
        renderKanban();
        closeModal();
        form.reset();
        showToast('Lead Added', `${newLead.company} added to campaign pipeline.`);
      });
    }

    // Helper: Copy to Clipboard without alert()
    function copyToClipboard(text) {
      const tempTextArea = document.createElement("textarea");
      tempTextArea.value = text;
      tempTextArea.style.position = "fixed";
      tempTextArea.style.left = "-9999px";
      document.body.appendChild(tempTextArea);
      tempTextArea.select();
      try {
        document.execCommand('copy');
      } catch (err) {
        console.error('Copy fallback failed', err);
      }
      document.body.removeChild(tempTextArea);
    }

    // Toast Manager
    let toastTimeout;
    function showToast(title, desc) {
      const toast = document.getElementById('toastNotification');
      document.getElementById('toastTitle').innerText = title;
      document.getElementById('toastDesc').innerText = desc;

      clearTimeout(toastTimeout);
      toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-12');
      toast.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');

      toastTimeout = setTimeout(() => {
        toast.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-12');
      }, 2500);
    }
  </script>
