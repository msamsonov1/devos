      },
      {
        day: 'Day 2',
        channel: 'LinkedIn Touch',
        icon: 'ph-linkedin-logo',
        color: 'sky',
        angle: 'Soft Profile Connection',
        desc: 'View profile, send a blank connection request or a 1-sentence note. DO NOT pitch yet.',
        metric: 'Builds warm recognition'
      },
      {
        day: 'Day 5',
        channel: 'Cold Email 2',
        icon: 'ph-arrow-bend-down-right',
        color: 'indigo',
