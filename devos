<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AgencyLead OS - Software Dev Outreach Engine</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <!-- Phosphor Icons -->
  <script src="https://unpkg.com/@phosphor-icons/web"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
              900: '#312e81',
            }
          }
        }
      }
    }
  </script>
  <style>
    /* Custom scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }
    .badge-glow {
      box-shadow: 0 0 12px rgba(99, 102, 241, 0.35);
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans flex flex-col antialiased selection:bg-indigo-600 selection:text-white">

  <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white shadow-lg shadow-indigo-500/25">
          <i class="ph-bold ph-paper-plane-tilt text-xl"></i>
        </div>
        <div>
          <h1 class="font-bold text-base sm:text-lg tracking-tight flex items-center gap-2">
            <span>DevPipeline OS</span>
            <span class="text-[10px] uppercase font-semibold px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">Agency Edition</span>
          </h1>
          <p class="text-xs text-slate-400 hidden sm:block">Trigger-Based Lead Outreach & Multi-Touch Cadence Engine</p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button id="resetDemoBtn" class="text-xs text-slate-400 hover:text-slate-200 px-3 py-1.5 rounded-lg border border-slate-800 hover:bg-slate-800 transition flex items-center gap-1.5">
          <i class="ph ph-arrow-counter-clockwise"></i>
          <span>Reset Defaults</span>
        </button>
        <div class="h-4 w-[1px] bg-slate-800 hidden sm:block"></div>
        <span class="text-xs text-emerald-400 bg-emerald-950/60 border border-emerald-800/60 px-2.5 py-1 rounded-full flex items-center gap-1.5 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          21-Day Sequence Active
        </span>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col gap-6">

    <!-- Tab navigation -->
    <div class="flex items-center justify-between border-b border-slate-800/80 pb-3">
      <nav class="flex space-x-2 sm:space-x-4 overflow-x-auto pb-1" id="tabNav">
        <button data-tab="sequence" class="tab-btn active px-3.5 py-2 rounded-lg text-sm font-medium transition flex items-center gap-2 text-white bg-indigo-600 shadow-sm shadow-indigo-600/30">
          <i class="ph ph-calendar-check text-base"></i>
          <span>21-Day Cadence</span>
        </button>
        <button data-tab="generator" class="tab-btn px-3.5 py-2 rounded-lg text-sm font-medium transition flex items-center gap-2 text-slate-400 hover:text-slate-200 hover:bg-slate-900">
          <i class="ph ph-pencil-simple-line text-base"></i>
          <span>Template Studio</span>
        </button>
        <button data-tab="objections" class="tab-btn px-3.5 py-2 rounded-lg text-sm font-medium transition flex items-center gap-2 text-slate-400 hover:text-slate-200 hover:bg-slate-900">
          <i class="ph ph-shield-check text-base"></i>
          <span>Objection Playbook</span>
        </button>
        <button data-tab="tracker" class="tab-btn px-3.5 py-2 rounded-lg text-sm font-medium transition flex items-center gap-2 text-slate-400 hover:text-slate-200 hover:bg-slate-900">
          <i class="ph ph-kanban text-base"></i>
          <span>Lead Tracker</span>
        </button>
      </nav>
      
      <div class="hidden lg:flex items-center gap-2 text-xs text-slate-400">
        <i class="ph ph-lightbulb text-amber-400"></i>
        <span>Target: 50 accounts/mo with verified hiring or roadmap triggers</span>
      </div>
    </div>

    <section id="sequenceTab" class="tab-content block space-y-6">
      
      <!-- Top Trigger Bar -->
      <div class="bg-gradient-to-r from-slate-900 via-indigo-950/40 to-slate-900 border border-slate-800 p-4 sm:p-5 rounded-2xl flex flex-col md:flex-row gap-4 items-start md:items-center justify-between">
        <div class="space-y-1">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-indigo-400 flex items-center gap-2">
            <i class="ph-fill ph-crosshair"></i> Primary Buying Triggers
          </h2>
          <p class="text-xs text-slate-300">Target accounts exhibiting one of these 3 high-intent indicators before initiating day 1:</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 w-full md:w-auto">
          <div class="bg-slate-900/90 border border-slate-800/80 px-3 py-2 rounded-xl text-xs flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <div>
              <span class="font-medium text-slate-200">Active Job Post</span>
              <p class="text-[10px] text-slate-400">Hiring Sr. Dev / Backlog debt</p>
            </div>
          </div>
          <div class="bg-slate-900/90 border border-slate-800/80 px-3 py-2 rounded-xl text-xs flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
            <div>
              <span class="font-medium text-slate-200">Funding / Launch</span>
              <p class="text-[10px] text-slate-400">Fresh Seed/Series A capital</p>
            </div>
          </div>
          <div class="bg-slate-900/90 border border-slate-800/80 px-3 py-2 rounded-xl text-xs flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            <div>
              <span class="font-medium text-slate-200">Legacy Architecture</span>
              <p class="text-[10px] text-slate-400">Needs migration / Mobile revamp</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Timeline Steps -->
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-4" id="cadenceGrid">
        <!-- Cadence cards will be rendered dynamically by JavaScript -->
      </div>

      <!-- Quick Action Guide -->
      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-5">
        <h3 class="text-sm font-semibold text-slate-200 mb-3 flex items-center gap-2">
          <i class="ph-bold ph-strategy text-indigo-400"></i> Execution Rules for Software Outreach
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-slate-300">
          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800/80">
            <span class="font-semibold text-indigo-300 block mb-1">1. Keep Words Under 120</span>
            Technical executives (CTOs/Heads of Product) read email on phones between standups. Long walls of text get deleted immediately.
          </div>
          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800/80">
            <span class="font-semibold text-indigo-300 block mb-1">2. Thread Replies (Don't New-Email)</span>
            Follow-ups on Day 5, 15, and 21 should reply directly to the same email thread to preserve conversational context.
          </div>
          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800/80">
            <span class="font-semibold text-indigo-300 block mb-1">3. Soft Free Value Asset</span>
            Don't ask for a 45-minute demo. Offer an asynchronous freebie like an architecture audit or UX teardown to demonstrate technical capability.
          </div>
        </div>
      </div>
    </section>

    <section id="generatorTab" class="tab-content hidden space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left: Prospect Variable Controls -->
        <div class="lg:col-span-4 bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-4">
          <div class="border-b border-slate-800 pb-3 flex items-center justify-between">
            <h3 class="text-sm font-semibold text-slate-200 flex items-center gap-2">
              <i class="ph ph-sliders text-indigo-400"></i> Prospect Variables
            </h3>
            <span class="text-[10px] text-slate-400">Injects into drafts live</span>
          </div>

          <div class="space-y-3 text-xs">
            <div>
              <label class="block text-slate-400 mb-1">Prospect First Name</label>
              <input id="varFirstName" type="text" value="Alex" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-indigo-500">
            </div>

            <div>
              <label class="block text-slate-400 mb-1">Company Name</label>
              <input id="varCompany" type="text" value="Nexus Logistics" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-indigo-500">
            </div>

            <div>
              <label class="block text-slate-400 mb-1">Trigger / Role Observed</label>
              <input id="varTrigger" type="text" value="Senior React Native Developer" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-indigo-500">
            </div>

            <div>
              <label class="block text-slate-400 mb-1">Target Product / Tech Area</label>
              <input id="varProduct" type="text" value="driver mobile dispatch app" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-indigo-500">
            </div>

            <div>
              <label class="block text-slate-400 mb-1">Similar Peer Client (Social Proof)</label>
              <input id="varProofClient" type="text" value="FleetTrack Inc." class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-indigo-500">
            </div>

            <div>
              <label class="block text-slate-400 mb-1">Measurable Result Achieved</label>
              <input id="varProofResult" type="text" value="shaved 4 weeks off their launch cycle" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-indigo-500">
            </div>

            <div>
              <label class="block text-slate-400 mb-1">Your Name / Agency</label>
              <input id="varSender" type="text" value="Marcus | ShiftBit Labs" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-indigo-500">
            </div>
          </div>

          <div class="pt-2">
            <button id="applyPresetsBtn" class="w-full py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl font-medium text-xs transition flex items-center justify-center gap-1.5">
              <i class="ph ph-sparkle text-indigo-400"></i>
              <span>Load SaaS Founder Scenario</span>
            </button>
          </div>
        </div>

        <!-- Right: Generated Templates with Copy Buttons -->
        <div class="lg:col-span-8 space-y-4">
          
          <!-- Template selector pills -->
          <div class="flex items-center gap-2 overflow-x-auto pb-1" id="templatePills">
            <button data-template="email1" class="template-pill active px-3 py-1.5 rounded-lg text-xs font-medium bg-indigo-600 text-white transition">Day 1: The Observation</button>
            <button data-template="linkedin" class="template-pill px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-900 border border-slate-800 text-slate-300 hover:text-white transition">Day 2: LinkedIn Note</button>
            <button data-template="email2" class="template-pill px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-900 border border-slate-800 text-slate-300 hover:text-white transition">Day 5: Proof Point</button>
            <button data-template="call" class="template-pill px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-900 border border-slate-800 text-slate-300 hover:text-white transition">Day 11: 30s Phone Script</button>
            <button data-template="email3" class="template-pill px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-900 border border-slate-800 text-slate-300 hover:text-white transition">Day 15: Low-Friction Offer</button>
            <button data-template="email4" class="template-pill px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-900 border border-slate-800 text-slate-300 hover:text-white transition">Day 21: Clean Breakup</button>
          </div>

          <!-- Preview & Action Box -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4 relative">
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-3">
              <div>
                <span id="previewTitle" class="text-sm font-semibold text-slate-200">Email 1 - Day 1: The Specific Observation</span>
                <p id="previewSubtitle" class="text-xs text-slate-400">Trigger: Active job listing or public roadmap delay</p>
              </div>
              <div class="flex items-center gap-2">
                <button id="copySubjectBtn" class="text-xs px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition flex items-center gap-1">
                  <i class="ph ph-copy"></i>
                  <span>Copy Subject</span>
                </button>
                <button id="copyBodyBtn" class="text-xs px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium shadow-md shadow-indigo-600/30 transition flex items-center gap-1.5">
                  <i class="ph-bold ph-copy-simple"></i>
                  <span>Copy Full Message</span>
                </button>
              </div>
            </div>

            <!-- Subject Line Container -->
            <div id="subjectContainer" class="bg-slate-950 border border-slate-800/80 rounded-xl p-3 flex items-center justify-between">
              <div class="text-xs">
                <span class="text-slate-500 font-mono mr-2">Subject:</span>
                <span id="subjectText" class="text-slate-200 font-medium font-sans"></span>
              </div>
              <span class="text-[10px] text-indigo-400 font-mono uppercase">Thread Root</span>
            </div>

            <!-- Body Container -->
            <div class="bg-slate-950 border border-slate-800/80 rounded-xl p-4 font-sans text-xs sm:text-sm leading-relaxed text-slate-300 space-y-3 whitespace-pre-wrap font-normal" id="bodyText">
            </div>

            <!-- Tip bar -->
            <div class="pt-2 flex items-center gap-2 text-[11px] text-slate-400 border-t border-slate-800/60">
              <i class="ph ph-info text-indigo-400 text-sm"></i>
              <span id="channelTip">Tip: Never send this from your primary domain. Always warm secondary sending inboxes.</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="objectionsTab" class="tab-content hidden space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h2 class="text-base font-bold text-slate-100">Response Playbooks & Objections</h2>
          <p class="text-xs text-slate-400">When tech buyers reply, 90% of answers fall into these four categories. Pivot them back to engagement.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="objectionCards">
        <!-- Rendered via JS -->
      </div>
    </section>

    <section id="trackerTab" class="tab-content hidden space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="text-base font-bold text-slate-100">Prospect Execution Pipeline</h2>
          <p class="text-xs text-slate-400">Track active software prospects through the 21-day multi-channel workflow.</p>
        </div>
        <div class="flex items-center gap-2">
          <button id="addLeadModalBtn" class="text-xs px-3 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl font-medium transition flex items-center gap-1.5 shadow-md shadow-indigo-600/25">
            <i class="ph-bold ph-plus"></i>
            <span>Add New Prospect</span>
          </button>
        </div>
      </div>

      <!-- Kanban Columns -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        
        <!-- Stage 1 -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 flex flex-col min-h-[480px]">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-300 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-slate-400"></span> Day 1–2 Outreach
            </span>
            <span id="colCount-outreach" class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 font-mono font-medium">0</span>
          </div>
          <div id="col-outreach" class="space-y-2.5 flex-1 overflow-y-auto"></div>
        </div>

        <!-- Stage 2 -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 flex flex-col min-h-[480px]">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-indigo-400 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-indigo-500"></span> In Follow-Up (Day 5–15)
            </span>
            <span id="colCount-followup" class="text-xs px-2 py-0.5 rounded-full bg-indigo-950 text-indigo-300 font-mono font-medium">0</span>
          </div>
          <div id="col-followup" class="space-y-2.5 flex-1 overflow-y-auto"></div>
        </div>

        <!-- Stage 3 -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 flex flex-col min-h-[480px]">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span> Engaged / Meeting Set
            </span>
            <span id="colCount-meeting" class="text-xs px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-300 font-mono font-medium">0</span>
          </div>
          <div id="col-meeting" class="space-y-2.5 flex-1 overflow-y-auto"></div>
        </div>

        <!-- Stage 4 -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 flex flex-col min-h-[480px]">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-amber-400 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-amber-400"></span> Closed / Breakup
            </span>
            <span id="colCount-closed" class="text-xs px-2 py-0.5 rounded-full bg-amber-950 text-amber-300 font-mono font-medium">0</span>
          </div>
          <div id="col-closed" class="space-y-2.5 flex-1 overflow-y-auto"></div>
        </div>

      </div>
    </section>

  </main>

  <!-- Toast Notification Box -->
  <div id="toastNotification" class="fixed bottom-6 right-6 z-50 transform translate-y-12 opacity-0 pointer-events-none transition-all duration-300 bg-slate-900 border border-indigo-500/40 text-slate-100 px-4 py-3 rounded-xl shadow-2xl flex items-center gap-3">
    <div class="w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-white">
      <i class="ph-bold ph-check text-sm"></i>
    </div>
    <div class="text-xs">
      <p class="font-semibold text-slate-200" id="toastTitle">Copied to Clipboard</p>
      <p class="text-slate-400 text-[11px]" id="toastDesc">Ready to paste into your sending tool.</p>
    </div>
  </div>

  <!-- Add Prospect Modal (Custom UI, avoiding alert/confirm) -->
  <div id="addModalOverlay" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-sm font-bold text-slate-100 flex items-center gap-2">
          <i class="ph-bold ph-user-plus text-indigo-400"></i> New Lead Entry
        </h3>
        <button id="closeModalBtn" class="text-slate-400 hover:text-white p-1 rounded-lg">
          <i class="ph ph-x text-base"></i>
        </button>
      </div>

      <form id="newLeadForm" class="space-y-3 text-xs">
        <div>
          <label class="block text-slate-400 mb-1">Contact Name & Title</label>
          <input required id="leadName" type="text" placeholder="e.g. Sarah Jenkins (VP Eng)" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-indigo-500">
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Company</label>
          <input required id="leadCompany" type="text" placeholder="e.g. HealthBridge Logistics" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-indigo-500">
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Identified Trigger</label>
          <select id="leadTrigger" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-indigo-500">
            <option value="Hiring Senior Engineers">Hiring Senior Engineers (Roadmap Backlog)</option>
            <option value="Fresh Seed/Series A">Fresh Capital / Fast Roadmap Pressure</option>
            <option value="Outdated Mobile/Web App">Legacy Architecture / Needs Modernization</option>
            <option value="Re-platforming Project">Cloud / Tech Stack Migration</option>
          </select>
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Initial Stage</label>
          <select id="leadStage" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-indigo-500">
            <option value="outreach">Day 1–2 Outreach</option>
            <option value="followup">In Follow-Up (Day 5–15)</option>
            <option value="meeting">Engaged / Meeting Set</option>
          </select>
        </div>

        <div class="pt-2 flex items-center justify-end gap-2">
